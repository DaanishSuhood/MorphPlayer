<Window x:Class="MorphPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MorphPlayer" Icon="Assets/MorphPlayer.ico" Width="1100" Height="650" MinWidth="560" MinHeight="340"
        Background="#101010" AllowDrop="True"
        PreviewKeyDown="OnKeyDown" Closed="OnClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <vlc:VideoView x:Name="Video" Background="Black" Loaded="Video_Loaded">
            <!-- Overlay content is rendered in a transparent window above the video.
                 The near-transparent background keeps it hit-testable for mouse/drop events. -->
            <Grid x:Name="Overlay" Background="#01000000" AllowDrop="True"
                  Drop="Overlay_Drop" MouseMove="Overlay_MouseMove"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseWheel="Overlay_MouseWheel"
                  Loaded="Overlay_Loaded">
                <Grid.ContextMenu>
                    <!-- The track, subtitle, device, stereo, quality and updates submenus are filled in OverlayMenu_Opened. -->
                    <ContextMenu Opened="OverlayMenu_Opened" Closed="Menu_Closed">
                        <MenuItem Header="Open File(s)…" InputGestureText="Ctrl+O" Click="OpenFiles_Click"/>
                        <MenuItem Header="Open Folder…" InputGestureText="Ctrl+F" Click="OpenFolder_Click"/>
                        <MenuItem Header="Open Network Stream…" InputGestureText="Ctrl+N" Click="OpenUrl_Click"/>
                        <Separator/>
                        <MenuItem x:Name="AudioTrackMenu" Header="Audio Track"/>
                        <MenuItem x:Name="SubtitleMenu" Header="Subtitles"/>
                        <Separator/>
                        <MenuItem x:Name="AudioDeviceMenu" Header="Audio Device"/>
                        <MenuItem x:Name="StereoModeMenu" Header="Stereo Mode"/>
                        <MenuItem x:Name="QualityMenu" Header="Website Video Quality"/>
                        <Separator/>
                        <MenuItem Header="Playlist" InputGestureText="Ctrl+L" Click="Playlist_Click"/>
                        <MenuItem Header="Fullscreen" InputGestureText="F" Click="Fullscreen_Click"/>
                        <Separator/>
                        <MenuItem x:Name="UpdatesMenu" Header="Updates"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="56"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop media files here" FontSize="18" Foreground="{StaticResource Fg}"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="or press Ctrl+O to open · Ctrl+N for a stream or YouTube link" FontSize="13"
                               Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Shown while an audio-only file plays: the cover art if there is one, else a music note.
                     The Viewbox shrinks it to fit small windows, above the control bar. -->
                <Viewbox x:Name="AudioInfo" Visibility="Collapsed" StretchDirection="DownOnly" IsHitTestVisible="False"
                         Margin="24,24,24,110">
                    <StackPanel MaxWidth="560">
                        <TextBlock x:Name="MusicGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="72"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <Border x:Name="CoverFrame" Visibility="Collapsed" HorizontalAlignment="Center"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <Image x:Name="CoverImage" MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Text, ElementName=TitleText}" FontSize="20" Foreground="{StaticResource Fg}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
                        <TextBlock x:Name="AudioDetails" Visibility="Collapsed" FontSize="15" Foreground="{StaticResource FgDim}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Viewbox>

                <!-- Shown for a few seconds when a file picks up where it was left -->
                <Border x:Name="ResumeBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="16" Background="#E0181818" CornerRadius="6" Padding="14,4,4,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ResumeText" Foreground="{StaticResource Fg}" FontSize="14" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TextButton}" Content="Start over" Foreground="{StaticResource Accent}"
                                Height="30" Margin="10,0,0,0" Click="StartOver_Click"/>
                    </StackPanel>
                </Border>

                <!-- Asks before fetching yt-dlp, the first time a web page is opened; see AskToGetYtDlp -->
                <Border x:Name="YtDlpPrompt" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="24,24,24,110" MaxWidth="500" Background="#E0181818" CornerRadius="6" Padding="18,14,10,8">
                    <StackPanel>
                        <TextBlock Text="Play website links with yt-dlp?" Foreground="{StaticResource Fg}" FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource FgDim}" FontSize="13" TextWrapping="Wrap" Margin="0,6,8,6"
                                   Text="To play YouTube and other website links, MorphPlayer needs yt-dlp, plus Deno, which yt-dlp uses for YouTube. It can download both from GitHub now (about 65 MB) and keep yt-dlp up to date. If not, it tries the link on its own, and you can get yt-dlp later under Updates in the right-click menu."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource TextButton}" Content="Not now" Height="30" Click="DeclineYtDlp_Click"/>
                            <Button Style="{StaticResource TextButton}" Content="Download" Foreground="{StaticResource Accent}"
                                    Height="30" Margin="6,0,0,0" Click="AcceptYtDlp_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Shown for a while at start-up when GitHub has a newer release -->
                <Border x:Name="UpdateBanner" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="16" Background="#E0181818" CornerRadius="6" Padding="14,4,4,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateText" Foreground="{StaticResource Fg}" FontSize="14" VerticalAlignment="Center"/>
                        <Button x:Name="UpdateButton" Style="{StaticResource TextButton}" Content="Update" Foreground="{StaticResource Accent}"
                                Height="30" Margin="10,0,0,0" Click="DownloadUpdate_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Height="30" MinWidth="30"
                                ToolTip="Don't show this again until the next version" Click="DismissUpdate_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OsdBorder" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                        Background="#B0000000" CornerRadius="4" Padding="12,6">
                    <TextBlock x:Name="OsdText" Foreground="White" FontSize="16" TextWrapping="Wrap" MaxWidth="560"/>
                </Border>

                <Border x:Name="ControlBar" VerticalAlignment="Bottom" Padding="12,18,12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#C8000000" Offset="0.4"/>
                            <GradientStop Color="#E8000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="2,0,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText" Text="0:00" Foreground="{StaticResource Fg}"
                                       VerticalAlignment="Center" MinWidth="44"/>
                            <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0" Maximum="1" Margin="10,0" IsEnabled="False"
                                    Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                                    ValueChanged="Seek_ValueChanged" MouseMove="Seek_MouseMove" MouseLeave="Seek_MouseLeave"/>
                            <TextBlock x:Name="LengthText" Grid.Column="2" Text="--:--" Foreground="{StaticResource Fg}"
                                       VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"/>
                        </Grid>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" FontSize="20" Content="&#xE768;"
                                        ToolTip="Play / Pause (Space)" Click="Play_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop (S)" Click="Stop_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (P)" Click="Prev_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (N)" Click="Next_Click"/>
                                <Border Width="1" Background="#40FFFFFF" Margin="6,8"/>
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;"
                                        ToolTip="Shuffle" Click="Shuffle_Click"/>
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;"
                                        ToolTip="Repeat: off" Click="Repeat_Click"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- Only while a website video plays; shows what yt-dlp picked, e.g. 1080p60 -->
                                <Button x:Name="QualityButton" Style="{StaticResource TextButton}" Visibility="Collapsed"
                                        ToolTip="Website video quality" Click="Quality_Click"/>
                                <Button x:Name="SpeedButton" Style="{StaticResource TextButton}" Content="1x"
                                        ToolTip="Playback speed ([ and ])" Click="Speed_Click"/>
                                <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE8D6;"
                                        ToolTip="Audio track (B)" Click="AudioTracks_Click"/>
                                <Button x:Name="SubtitleButton" Style="{StaticResource IconButton}" Content="&#xE7F0;"
                                        ToolTip="Subtitles (V)" Click="Subtitles_Click"/>
                                <Border Width="1" Background="#40FFFFFF" Margin="6,8"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open file(s) (Ctrl+O)" Click="OpenFiles_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="Open network stream (Ctrl+N)" Click="OpenUrl_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Playlist (Ctrl+L)" Click="Playlist_Click"/>
                                <Border Width="1" Background="#40FFFFFF" Margin="6,8"/>
                                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                                        ToolTip="Mute (M)" Click="Mute_Click"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource FlatSlider}" Width="90"
                                        Minimum="0" Maximum="100" Value="80" Margin="2,0,8,0"/>
                                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                        ToolTip="Fullscreen (F)" Click="Fullscreen_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="TitleText" Foreground="{StaticResource FgDim}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Frame and time under the pointer while hovering the seek bar; placed in Seek_MouseMove -->
                <Border x:Name="SeekPreview" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="#F0101010" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="3">
                    <StackPanel>
                        <Image x:Name="SeekPreviewImage" Visibility="Collapsed" Width="240" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="SeekPreviewTime" Foreground="White" FontSize="13" HorizontalAlignment="Center"
                                   Margin="6,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>

        <Border x:Name="PlaylistPanel" Grid.Column="1" Width="300" Background="{StaticResource Panel}"
                BorderBrush="#2A2A2A" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,8,6,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add files" Click="AddFiles_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE738;" ToolTip="Remove selected (Del)" Click="RemoveSelected_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear playlist" Click="ClearPlaylist_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PlaylistHeader" Text="Playlist" Foreground="{StaticResource Fg}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True" Drop="Playlist_Drop" MouseDoubleClick="Playlist_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Source}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- A frame from the video or the cover art; an icon until (or unless) there is one -->
                                <Border x:Name="ThumbBox" Width="64" Height="36" Background="#262626" CornerRadius="3"
                                        BorderThickness="1" BorderBrush="Transparent" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="Glyph" Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="14"
                                                   Foreground="{StaticResource FgDim}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Label" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailsText" Text="{Binding Details}" FontSize="11"
                                               Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasVideo}" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8D6;"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                    <Setter TargetName="DetailsText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="ThumbBox" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
